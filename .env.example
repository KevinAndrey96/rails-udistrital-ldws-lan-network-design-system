# Copy to .env and fill in. Never commit the real .env file.

# Required in production. Generate with: bundle exec rake secret
SECRET_KEY_BASE=

# Optional: rotate Devise tokens independently from SECRET_KEY_BASE.
DEVISE_SECRET_KEY=

# Production database (either DATABASE_URL or the discrete settings).
DATABASE_URL=
LDWS_DATABASE_HOST=localhost
LDWS_DATABASE_NAME=ldws_production
LDWS_DATABASE_USERNAME=ldws
LDWS_DATABASE_PASSWORD=

# Public host used in mailer links, for example ldws.example.com
APP_HOST=localhost:3000
MAILER_SENDER=no-reply@ldws.local

# Optional SMTP delivery. Leave SMTP_ADDRESS empty to disable it.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# Seeded administrator. A random password is generated and printed when empty.
LDWS_ADMIN_EMAIL=admin@ldws.local
LDWS_ADMIN_PASSWORD=

# Serve /public from Rails (needed when no reverse proxy is in front).
RAILS_SERVE_STATIC_FILES=true
