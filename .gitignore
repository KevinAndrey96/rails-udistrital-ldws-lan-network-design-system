# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Bundler
/.bundle
/vendor/bundle

# SQLite databases
/db/*.sqlite3
/db/*.sqlite3-journal

# Logs and temporary files
/log/*
!/log/.keep
/tmp
.byebug_history

# Build artifacts: precompiled assets and generated API docs
/public/assets
/doc

# Local environment
.env
.env.*
!.env.example

# OS and editor noise
.DS_Store
.idea/
.vscode/
